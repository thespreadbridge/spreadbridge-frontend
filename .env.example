# Server-only API origin. This uses the existing member/subscription database.
SPREADBRIDGE_API_URL=https://dollarflow.growbee.ai/v1

# Use an isolated API explicitly when working with test accounts instead of real members.
# SPREADBRIDGE_API_URL=http://127.0.0.1:8080/v1

# Optional canonical site origin behind a proxy. Omit locally to retain 127.0.0.1.
# SPREADBRIDGE_SITE_ORIGIN=https://thespreadbridge.com
